# Environment variables for local development with tunnels
#
# Copy this file to .env.local and fill in your ngrok tunnel URLs
# These are only needed when running locally against tunneled services

# FHIR Server URL (ngrok tunnel to your local HAPI FHIR server)
# Example: https://abc123.ngrok-free.app/fhir
VITE_FHIR_BASE_URL=/fhir

# Snowstorm Terminology Server URL (ngrok tunnel to your local Snowstorm)
# Example: https://def456.ngrok-free.app
VITE_SNOWSTORM_BASE_URL=/snowstorm
